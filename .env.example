# Fill these two values locally before generating your Telethon session.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH

# The deployed Render service will also need these variables:
# BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# TELEGRAM_SESSION=YOUR_GENERATED_TELETHON_STRING_SESSION
# STORAGE_CHANNEL=YOUR_PRIVATE_CHANNEL_ID_OR_USERNAME
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# ADMIN_USER_ID=YOUR_TELEGRAM_USER_ID
# GROQ_MODEL=llama-3.3-70b-versatile
# MAX_STORAGE_SCAN=2500
# MAX_SYNC_PER_GROUP=300
# TIMEZONE=Asia/Kolkata
# LOG_LEVEL=INFO
